    "react-dom": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "node": "^24",
    "typescript": "latest"
  },
  "engines": { "node": ">=24 <25" }
}
